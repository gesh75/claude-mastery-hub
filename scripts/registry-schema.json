{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gesh75.github.io/claude-mastery-hub/registry-schema.json",
  "title": "Claude Mastery Hub volatile-fact registry",
  "description": "Shape of MODEL_SOURCES, MODEL_FACTS and BENCHMARK_EVIDENCE. Every object node sets additionalProperties:false on purpose: an open shape lets a typo'd field validate silently, and a field the renderer never reads is exactly the drift this registry exists to prevent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verifiedAt", "sources", "facts", "benchmarks"],
  "properties": {
    "verifiedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date of the last currency review. Staleness is surfaced by the checker, never failed."
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "url"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" }
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "shortName", "id", "sources"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "shortName": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "pattern": "^claude-" },
            "positioning": { "type": "string" },
            "speed": { "type": "string" },
            "inputPrice": { "type": "number", "minimum": 0 },
            "outputPrice": { "type": "number", "minimum": 0 },
            "standardInputPrice": { "type": "number", "minimum": 0 },
            "standardOutputPrice": { "type": "number", "minimum": 0 },
            "priceNote": { "type": "string" },
            "context": { "type": "string" },
            "maxOutput": { "type": "string" },
            "thinking": { "type": "string" },
            "reliableKnowledgeCutoff": { "type": "string" },
            "trainingDataCutoff": { "type": "string" },
            "availability": { "type": "string" },
            "featureExceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "featureExceptionsNote": { "type": "string", "minLength": 1 },
            "fastMode": {
              "type": "object",
              "additionalProperties": false,
              "required": ["inputPrice", "outputPrice", "availableOn", "unavailableOn", "speedClaim"],
              "properties": {
                "inputPrice": { "type": "number", "minimum": 0 },
                "outputPrice": { "type": "number", "minimum": 0 },
                "availableOn": { "type": "string", "minLength": 1 },
                "unavailableOn": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "speedClaim": { "type": "string", "minLength": 1 }
              }
            },
            "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "use": { "type": "string" }
          },
          "dependencies": {
            "featureExceptions": ["featureExceptionsNote"]
          }
        }
      }
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "measures", "provenance", "limitation"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "measures": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "minLength": 1 },
            "resultTemplate": { "type": "string", "minLength": 1 },
            "exactScore": { "type": "number" },
            "roundedScore": { "type": "number" },
            "effort": { "type": "string" },
            "provenance": {
              "description": "Who produced the number. DECISION_LOG 2026-07-28: a benchmark claim without provenance is not a fact.",
              "enum": [
                "Anthropic-run",
                "Anthropic-reported",
                "ARC Prize-verified",
                "Cursor-reported",
                "Zapier-reported",
                "External benchmark-owner verified",
                "Partner-reported",
                "Unable to verify"
              ]
            },
            "limitation": { "type": "string", "minLength": 1 }
          },
          "dependencies": {
            "resultTemplate": ["exactScore", "roundedScore", "effort"],
            "exactScore": ["roundedScore"]
          }
        }
      }
    }
  }
}
